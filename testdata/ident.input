select `all`, [select] as [from] , r . read from `table`;

select `col``name` from t1;

select count ( * ) ;

replace into t1 values('a', 'b');

select replace ('sqlfmt','fmt','format');

ALTER TABLE t1
ADD INDEX index_name (c1),
ADD COLUMN col0 ENUM ('yes' ,'no') not null,
MODIFY foo int(1) null   ,
CHANGE c2 c2 DECIMAL(10,2) null after c1;

alter table t2
modify foo INT(2) not null;

SELECT modify
FROM bar;

CREATE PROCEDURE my_procedure();

CALL my_procedure('value') ;
