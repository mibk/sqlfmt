SELECT
p . id , DATE_FORMAT ( p.date ,'%Y-%m-%d %H:%i:%s' ) AS datestr, p.date,
	b.name AS title
FROM purchase p
JOIN building b ON p.station_id=b.id
WHERE p.user_id IN (
select user_id
 From   registry
Where id IN (  ?...  ) and registered <= curdate()
)
   ORDER BY p.date  ;

SELECT * FROM user  ;
select name from user where id=1

select *
from task
where user_id in (
	'Alice'  ,
	'Bob'    ,
	'Cecil'  )
;

select a
from t where x = 1 order by a;

select a from t
where x = 1 order by a;
