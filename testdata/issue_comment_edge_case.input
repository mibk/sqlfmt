SELECT
	IF(TRUE,
		'yes',
		'no'
	) affirmation, # This is always true
	stayHere
FROM foo;

SELECT
	(t.finished IS NOT NULL) task_closed,

	# This comment must not deindent.
	t.other
FROM foo t;

SELECT
	EXISTS (
		SELECT 1
		FROM bar
	) existing,
	# Do not deindent this.
	IF(f.value, 'yes', 'no') AS special
FROM foo;
