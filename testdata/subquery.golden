SELECT (is_admin OR EXISTS (
	SELECT 1
	FROM past_admins
	WHERE user_id = user.id))
FROM user;

SELECT ((is_admin OR EXISTS (
	SELECT 1
	FROM past_admins
	WHERE user_id = user.id)))
FROM user

SELECT
	CONCAT(b.name,
		b.publisher) info
FROM
	book b
;

