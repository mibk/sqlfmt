SELECT
	p.id, DATE_FORMAT(p.date, '%Y-%m-%d %H:%i:%s') AS datestr, p.date,
	b.name AS title
FROM purchase p
JOIN building b ON p.station_id = b.id
WHERE p.user_id IN (
	SELECT user_id
	FROM registry
	WHERE id IN (?...) AND registered <= CURDATE()
)
ORDER BY p.date;

SELECT * FROM user;
SELECT name FROM user WHERE id = 1

SELECT *
FROM task
WHERE user_id IN (
	'Alice',
	'Bob',
	'Cecil')
;
