select [foo],`bar`
from [table];

alter table t1
add index `index_name` (`column`);

select x<>y;

select `if`,`match`,`row_number`;

select cast(case
when true then 42
default 0
end as int (11))

select
	x . bar as bar,
	x . `bar` as `bar`,
	x . bar as `bar`,
	x . `bar` as foo,
	x . `bar`  bar
from foo as x;

# Do not remove the 'AS' keyword here.
SELECT CAST(created AS date);
