SELECT ( is_admin OR EXISTS(
	select 1
	from past_admins
	where user_id = user.id ))
FROM user;

SELECT (( is_admin OR EXISTS(
	select 1
	from past_admins
	where user_id = user.id )))
FROM user

SELECT
	CONCAT(b.name,
	b.publisher  ) info
FROM
	book b
;

SELECT    CONCAT(b.name ,
	  b.publisher   ) info
FROM book b             ;
